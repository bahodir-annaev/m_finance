# MIZAN Finance — environment template.
# Copy this file to .env and fill in real values. The .env file is gitignored.
#
#   cp .env.example .env
#
# All variables are optional — the app runs with sensible defaults if unset:
#   - MIZAN_SECRET_KEY: if omitted, a random key is generated and persisted
#     to .mizan_secret_key on first run.
#   - MIZAN_ADMIN_PASSWORD: if omitted, a random password is generated and
#     printed once to the console when the database is first created.
#   - PORT: if omitted, auto-detects (prefers 5000).

# Flask session signing key. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
MIZAN_SECRET_KEY=

# Password for the seeded 'admin' user (applied only on first DB creation).
MIZAN_ADMIN_PASSWORD=

# Port to run on (blank/0 = auto-detect, preferring 5000).
PORT=5000
